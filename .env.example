# Environment Variables Template
#
# Copy this file to apps/api/<service>/.env and fill in the values.
# Never commit .env files with real secrets to the repository.

# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/siakad_dev

# ─── Authentication ─────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@example.com
MAIL_PASSWORD=change_me
MAIL_FROM="Siakad Superapp <noreply@example.com>"

# ─── File Storage ────────────────────────────────────────────────────────────────
FILE_STORAGE_TYPE=local
# For S3-compatible storage:
# FILE_STORAGE_TYPE=s3
# AWS_REGION=ap-southeast-1
# AWS_BUCKET=siakad-files
# AWS_ACCESS_KEY_ID=change_me
# AWS_SECRET_ACCESS_KEY=change_me

# ─── Frontend URLs (CORS) ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Nx Cloud (optional) ─────────────────────────────────────────────────────────
# NX_CLOUD_ACCESS_TOKEN=
